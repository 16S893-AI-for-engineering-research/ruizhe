---
import { url, isActive } from '../lib/paths';
import { profile } from '../data/site';

const current = Astro.url.pathname;
const nav = [
  { label: 'Home', href: url('/') },
  { label: 'About', href: url('/about') },
  { label: 'Project', href: url('/project') },
  { label: 'Dev Log', href: url('/dev-log') },
];
---

<header class="sticky z-40 border-b border-line/70 bg-bg/85 backdrop-blur" style="top: env(safe-area-inset-top, 0px);">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a
      href={url('/')}
      class="group flex min-w-0 items-center gap-2.5 font-display text-[14px] font-medium tracking-tight sm:text-[15px]"
    >
      <span
        class="inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-accent transition-transform duration-300 group-hover:scale-125"
        aria-hidden="true"
      ></span>
      <span class="truncate">{profile.name}</span>
    </a>

    <div class="flex shrink-0 items-center gap-1">
      <nav aria-label="Primary" class="flex items-center gap-0.5">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(current, item.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-2 py-1.5 text-[12px] transition-colors sm:px-3 sm:text-[13px]',
                isActive(current, item.href)
                  ? 'text-ink font-medium bg-accent-soft'
                  : 'text-muted hover:text-ink hover:bg-line/40',
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Switch colour theme"
        class="ml-1 grid h-8 w-8 place-items-center rounded-md text-muted transition-colors hover:bg-line/40 hover:text-ink"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            stroke-linecap="round"
            d="M12 2.4v2.2M12 19.4v2.2M21.6 12h-2.2M4.6 12H2.4M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6M18.8 18.8l-1.6-1.6M6.8 6.8L5.2 5.2"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const currentTheme = root.dataset.theme || (prefersDark ? 'dark' : 'light');
      const next = currentTheme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode, blocked storage — the toggle still works for this page view */
      }
    });
  })();
</script>
