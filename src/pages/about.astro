---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, education, research, awards, skills, service } from '../data/site';

const contacts = [
  { label: 'Email', text: profile.email, href: `mailto:${profile.email}` },
  { label: 'Phone', text: profile.phone, href: `tel:${profile.phoneHref}` },
  { label: 'GitHub', text: profile.githubHandle, href: profile.github },
  { label: 'LinkedIn', text: 'ruizhe-huang', href: profile.linkedin },
];
---

<BaseLayout title="About" description={`About ${profile.name} — ${profile.role} at ${profile.affiliation}.`}>
  <section class="shell border-b border-line py-16 sm:py-20">
    <p class="eyebrow">About</p>
    <h1 class="mt-4 max-w-3xl font-display text-3xl font-medium leading-[1.15] sm:text-5xl">
      Making the small-scale structure of the atmosphere legible from the data we already have.
    </h1>
    <div class="mt-8 max-w-[68ch] space-y-5 text-[15px] leading-relaxed text-muted sm:text-base">
      <p>
        I’m a Ph.D. student in Mechanical Engineering and Computational Science and Engineering at MIT, working with{' '}
        <a href={profile.advisor.url} target="_blank" rel="noopener" class="link-underline">{profile.advisor.name}</a>.
        My background is in mechanics and numerical methods — I came to machine learning through PDEs, not the other way
        round, and it still shapes how I think about these problems.
      </p>
      <p>
        The thread running through my work is the gap between what we measure and what actually happens. Weather
        stations are sparse. Reanalysis grids average over kilometers. Satellites see a plume only under the right
        conditions. Each of those is a question about recovering structure that the observing system does not resolve
        directly — and about how you would know whether you had genuinely recovered it, rather than just fit the
        stations you can see.
      </p>
      <p>
        That last part is where I spend a lot of my time. Designing evaluations that can tell real sub-grid recovery
        apart from pointwise accuracy turns out to be at least as hard as designing the model.
      </p>
    </div>
  </section>

  <!-- Education -->
  <section class="shell py-14 sm:py-16">
    <h2 class="eyebrow">Education</h2>
    <div class="mt-7 space-y-6">
      {
        education.map((e) => (
          <div class="grid gap-1 border-l-2 border-line pl-5 sm:grid-cols-[1fr_auto] sm:gap-x-8">
            <div>
              <h3 class="font-display text-[19px] font-medium">{e.school}</h3>
              <p class="mt-0.5 text-[15px] text-muted">{e.degree}</p>
              {e.note && <p class="mt-1.5 text-[13px] text-muted">{e.note}</p>}
            </div>
            <div class="mt-1 text-left sm:mt-0 sm:text-right">
              <p class="font-mono text-[11px] text-muted">{e.period}</p>
              <p class="mt-0.5 text-[12px] text-muted">{e.place}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Research experience -->
  <section class="shell py-14 sm:py-16">
    <h2 class="eyebrow">Research experience</h2>
    <div class="mt-7 space-y-10">
      {
        research.map((r) => (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
              <h3 class="font-display text-xl font-medium sm:text-[22px]">{r.title}</h3>
              <span class="font-mono text-[11px] text-muted">{r.period}</span>
            </div>
            <p class="mt-2 text-[13px] text-muted">
              Advisor: {profile.advisor.name}
              {r.venue && <span class="ml-2 font-medium text-accent">· {r.venue}</span>}
            </p>
            <p class="mt-4 max-w-[68ch] text-[15px] leading-relaxed">{r.summary}</p>
            <ul class="mt-4 space-y-2.5">
              {r.points.map((p) => (
                <li class="flex max-w-[68ch] gap-3 text-[14px] leading-relaxed text-muted">
                  <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span>{p}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Awards + skills -->
  <section class="shell grid gap-12 py-14 sm:py-16 md:grid-cols-2">
    <div>
      <h2 class="eyebrow">Honors &amp; awards</h2>
      <ul class="mt-7 space-y-5">
        {
          awards.map((a) => (
            <li>
              <p class="text-[15px] font-medium">{a.name}</p>
              <p class="mt-0.5 text-[13px] text-muted">
                {a.detail} · {a.year}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="eyebrow">Technical skills</h2>
      <dl class="mt-7 space-y-4">
        {
          skills.map((s) => (
            <div>
              <dt class="text-[13px] font-medium">{s.group}</dt>
              <dd class="mt-1.5 flex flex-wrap gap-1.5">
                {s.items.map((i) => (
                  <span class="tag">{i}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Service -->
  <section class="shell py-14 sm:py-16">
    <h2 class="eyebrow">Service &amp; leadership</h2>
    <div class="mt-7 space-y-6">
      {
        service.map((s) => (
          <div class="grid gap-1 sm:grid-cols-[1fr_auto] sm:gap-x-8">
            <div>
              <h3 class="text-[15px] font-medium">{s.role}</h3>
              {s.detail && (
                <p class="mt-1 max-w-[68ch] text-[14px] leading-relaxed text-muted">{s.detail}</p>
              )}
            </div>
            <p class="font-mono text-[11px] text-muted sm:text-right">{s.period}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Contact -->
  <section class="shell py-14 sm:py-16">
    <div class="card p-6 sm:p-8">
      <h2 class="eyebrow">Get in touch</h2>
      <p class="mt-4 max-w-[68ch] text-[15px] leading-relaxed text-muted">
        Happy to talk about surface-weather recovery, generative assimilation, or satellite emissions monitoring.
      </p>
      <dl class="mt-7 grid gap-x-8 gap-y-5 sm:grid-cols-2">
        {
          contacts.map((c) => (
            <div>
              <dt class="eyebrow">{c.label}</dt>
              <dd class="mt-1.5">
                <a
                  href={c.href}
                  class="text-[15px] transition-colors hover:text-accent"
                  target={c.href.startsWith('http') ? '_blank' : undefined}
                  rel={c.href.startsWith('http') ? 'noopener' : undefined}
                >
                  {c.text}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
