---
import BaseLayout from '../layouts/BaseLayout.astro';
import { entries } from '../data/devlog';

const sorted = [...entries].sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout
  title="Dev Log"
  description="Notes on building with AI agents for engineering research — MIT 16.S893."
>
  <section class="shell border-b border-line py-16 sm:py-20">
    <p class="eyebrow">Dev Log</p>
    <h1 class="mt-4 max-w-3xl font-display text-3xl font-medium leading-[1.15] sm:text-5xl">
      Notes from working with agents
    </h1>
    <p class="mt-6 max-w-[68ch] text-[15px] leading-relaxed text-muted sm:text-base">
      A running record for 16.S893 — what I tried, what broke, and what I would do differently. Kept honest rather than
      tidy, because the failures are the part worth rereading.
    </p>
  </section>

  <section class="shell py-14 sm:py-16">
    {
      sorted.length === 0 ? (
        <p class="text-[15px] text-muted">No entries yet.</p>
      ) : (
        <ol class="space-y-14">
          {sorted.map((e) => (
            <li>
              <article>
                <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                  <time datetime={e.date} class="font-mono text-[11px] uppercase tracking-[0.14em] text-muted">
                    {e.displayDate}
                  </time>
                  <ul class="flex flex-wrap gap-1.5">
                    {e.tags.map((t) => (
                      <li class="tag">{t}</li>
                    ))}
                  </ul>
                </div>

                <h2 class="mt-3 font-display text-2xl font-medium leading-snug">{e.title}</h2>

                <div class="mt-4 max-w-[68ch] space-y-4 text-[15px] leading-relaxed text-muted">
                  {e.body.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>
</BaseLayout>
